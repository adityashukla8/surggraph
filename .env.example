# Copy to .env and fill in. Never commit the real .env file.

# GCP
SURGGRAPH_PROJECT_ID=
SURGGRAPH_REGION=us-central1
SURGGRAPH_GCS_BUCKET=surggraph-cases-${SURGGRAPH_PROJECT_ID}

# Gemini — gemini-3.5-flash may 404 on regional Vertex AI endpoints
# depending on project/rollout; `global` is the confirmed-working location
# as of 2026-08-12. See tools/gemini_model.py.
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global

# Agent Observability — ships real agent traces/metrics/logs to Cloud Trace,
# Cloud Monitoring, and Cloud Logging (tools/observability.py). Off by default
# since it exports real prompt/response text as span events. Requires
# telemetry.googleapis.com, cloudtrace.googleapis.com, logging.googleapis.com,
# monitoring.googleapis.com enabled on the project (already true here).
SURGGRAPH_ENABLE_CLOUD_TELEMETRY=

# FHIR (HAPI public test server — no auth required)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# State service (services/state_service) — local dev instance
STATE_SERVICE_URL=http://127.0.0.1:8080

# Firestore — the Living State Graph's real, multi-instance-safe backing
# store (plan §11). "(default)" is the real production database (created
# Day 18, per the plan's deferred-deployment split); local dev/tests point
# at the real, disposable surggraph-test database instead.
FIRESTORE_DATABASE=surggraph-test

# Alerting
SLACK_WEBHOOK_URL=

# RAG
EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest

# Literature retrieval — three independent live sources merged by RRF
# (agents/literature_retrieval/agent.py). Both keys below are optional; each
# source works unauthenticated and degrades gracefully without one.
#   NCBI_API_KEY — raises E-utilities' (PubMed) ceiling above 3 req/s.
#     https://www.ncbi.nlm.nih.gov/account/settings/ (under API Key Management)
#   SEMANTIC_SCHOLAR_API_KEY — the unauthenticated tier is genuinely
#     rate-limited in practice (confirmed live, not just documented caution);
#     a key raises this substantially. Apply at
#     https://www.semanticscholar.org/product/api#api-key-form
EUTILS_CONTACT_EMAIL=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Model Armor — screens the operative note's plain text (sanitize_model_
# response) right before write_document_reference files it to FHIR
# (agents/hitl/approval.py::_file_record, tools/model_armor.py). Template
# is provisioned separately via `gcloud model-armor templates create`, not
# by app code — a security template is an operator decision. Uses
# SURGGRAPH_PROJECT_ID/SURGGRAPH_REGION above; only the template id is new.
SURGGRAPH_MODEL_ARMOR_TEMPLATE_ID=surggraph-fhir-outbound

# MedGemma — real-latency SHADOW comparison only (tools/medgemma_model.py),
# fired alongside Complication Reasoning's and Documentation's real Gemini
# calls; never feeds the graph. Numeric id of a self-deployed Vertex AI
# Endpoint running medgemma-4b-it (`vertexai.preview.model_garden.OpenModel(
# "google/medgemma@medgemma-4b-it").deploy(...)`) — a real GPU-backed
# endpoint, left running rather than scaled to zero, specifically to avoid
# the multi-minute cold start that made an earlier, larger (27B) MedGemma
# deployment unworkable for a live demo. Leave unset to disable the shadow
# calls entirely — every call site no-ops cleanly without it.
MEDGEMMA_ENDPOINT_ID=

# Feedback knowledge base (plan_v2 §16, tools/feedback_kb.py) — the Memory
# Bank "parent Agent Engine" resource feedback memories are scoped under.
# Set to the deployed synthesis SurgBot subagent's resource name (same one
# Phase 6's reviewer-pattern memories already use); resolved via env, not an
# import, so the four core pipeline agents that read this KB never depend
# on agents/surgbot/'s deployment internals. Leave unset to disable — every
# call site fails soft to an empty advisory block, never breaking a case run.
SURGGRAPH_FEEDBACK_KB_ENGINE=
